# Copy this file to .env and fill in real values. .env is gitignored.

# --- OpenAI ---
OPENAI_API_KEY=sk-...

# --- Application ---
APP_ENV=development          # development | staging | production
LOG_LEVEL=INFO

# --- RAG configuration (reproducibility knobs) ---
CHUNK_SIZE=800
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=5
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-5-mini
JUDGE_MODEL=gpt-5-mini
PROMPT_VERSION=v1

# --- Paths ---
CHROMA_PERSIST_DIR=./data/chroma_db
RAW_DOCUMENTS_DIR=./data/raw_documents

# --- Retrieval strategy (ablation benchmarking) ---
USE_HYBRID_RETRIEVAL=false
USE_RERANKING=false
RETRIEVAL_CANDIDATE_POOL_SIZE=20
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Quality gate thresholds (regression testing) ---
MIN_ANSWER_CORRECTNESS=0.75
MIN_FAITHFULNESS=0.85
MIN_ABSTENTION_QUALITY=0.75
MAX_REGRESSION_PCT=0.10
MAX_GENERATION_LATENCY_SECONDS=10.0
MAX_FAILED_METRIC_RATE=0.05
